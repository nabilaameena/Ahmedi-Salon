{
  "name": "ahmedi-salon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ahmedi Salon — a synchronised, full-stack street-corner radio playing 90s Bollywood bangers.",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm --prefix server start",
    "preview": "npm run build && npm --prefix server start",
    "install:all": "npm install && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^5.4.10"
  }
}